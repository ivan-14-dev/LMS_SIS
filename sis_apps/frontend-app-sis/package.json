{
  "name": "@edx/frontend-app-sis",
  "version": "1.0.0",
  "description": "Open edX MFE for Student Information System (SIS)",
  "repository": {
    "type": "git",
    "url": "https://github.com/openedx/frontend-app-sis.git"
  },
  "browserslist": [
    "extends @edx/browserslist-config"
  ],
  "scripts": {
    "build": "fedx-scripts webpack",
    "dev": "fedx-scripts webpack-dev-server --progress",
    "i18n_extract": "fedx-scripts formatjs extract",
    "lint": "fedx-scripts eslint --ext .js,.jsx,.ts,.tsx .",
    "lint:fix": "fedx-scripts eslint --fix --ext .js,.jsx,.ts,.tsx .",
    "snapshot": "fedx-scripts jest --updateSnapshot",
    "start": "fedx-scripts webpack-dev-server --progress",
    "test": "fedx-scripts jest --coverage --passWithNoTests"
  },
  "dependencies": {
    "@edx/brand": "npm:@openedx/brand-openedx@^1.2.0",
    "@edx/frontend-component-footer": "^14.0.0",
    "@edx/frontend-component-header": "^8.0.0",
    "@edx/frontend-platform": "^8.0.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@openedx/paragon": "^22.0.0",
    "@tanstack/react-query": "^5.0.0",
    "axios": "^1.6.0",
    "core-js": "^3.32.0",
    "lodash": "^4.17.21",
    "prop-types": "^15.8.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-helmet": "^6.1.0",
    "react-redux": "^8.1.1",
    "react-router-dom": "^6.18.0",
    "redux": "^4.2.1",
    "regenerator-runtime": "^0.14.0"
  },
  "devDependencies": {
    "@edx/browserslist-config": "^1.2.0",
    "@openedx/frontend-build": "^14.6.17",
    "@testing-library/jest-dom": "^6.1.0",
    "@testing-library/react": "^14.0.0",
    "glob": "^10.3.0",
    "jest": "^29.7.0"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  }
}
