# =============================================================================
# Configuration SIS - Template
# =============================================================================
# Copier ce fichier en .env et compléter les valeurs
# NE JAMAIS commiter le fichier .env
# 
# Légende:
#   [REQUIS]    - Variable obligatoire, l'app ne démarrera pas sans
#   [PROD]      - Obligatoire en production uniquement
#   [OPTIONNEL] - Variable optionnelle avec valeur par défaut
# =============================================================================

# === MODE DE DÉPLOIEMENT [REQUIS] ===
# Options: secondaire | superieur | dual
SIS_MODE=dual

# =============================================================================
# SÉCURITÉ [REQUIS]
# =============================================================================

# [REQUIS] Clé secrète Django - OBLIGATOIRE
# Générer avec: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# [OPTIONNEL] Mode debug - False par défaut (sécurisé)
DJANGO_DEBUG=False

# [PROD] Hôtes autorisés - OBLIGATOIRE en production
# Exemple: sis.example.com,api.sis.example.com
DJANGO_ALLOWED_HOSTS=sis.example.com,*.sis.example.com

# =============================================================================
# BASE DE DONNÉES [REQUIS]
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_USER=sis

# Pour SIS Secondaire
DB_NAME_SECONDAIRE=sis_secondaire
DB_PASSWORD_SECONDAIRE=

# Pour SIS Supérieur
DB_NAME_SUPERIEUR=sis_superieur
DB_PASSWORD_SUPERIEUR=

# =============================================================================
# REDIS & CELERY [REQUIS]
# =============================================================================
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/3

# =============================================================================
# INTÉGRATION OPEN EDX [REQUIS pour la synchro LMS]
# =============================================================================

# [REQUIS] URLs du LMS et CMS
EDX_LMS_URL=http://localhost:18000
EDX_CMS_URL=http://localhost:18010

# [REQUIS] Credentials OAuth2 - créer via LMS Admin > OAuth2 Applications
EDX_OAUTH_CLIENT_ID=sis-integration
EDX_OAUTH_CLIENT_SECRET=

# [REQUIS] Secret pour valider les webhooks entrants du LMS
# Générer avec: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=

# =============================================================================
# CORS [PROD]
# =============================================================================
CORS_ALLOWED_ORIGINS=https://lms.example.com,https://studio.example.com

# =============================================================================
# EMAIL [OPTIONNEL - pour notifications]
# =============================================================================
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@sis.example.com

# =============================================================================
# STOCKAGE FICHIERS [OPTIONNEL - S3]
# =============================================================================
# Décommenter pour utiliser S3 au lieu du stockage local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=sis-media
# AWS_S3_REGION_NAME=eu-west-3

# =============================================================================
# MONITORING [OPTIONNEL]
# =============================================================================

# Sentry pour le tracking d'erreurs
# SENTRY_DSN=

# Niveau de log
LOG_LEVEL=INFO
